{
  "name": "clapculture-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@clapculture/web",
    "build": "npm run build --workspace=@clapculture/web",
    "pages:build": "npm run pages:build --workspace=@clapculture/web",
    "db:setup": "node scripts/setup-db.js",
    "db:admin-seed": "node scripts/seed-admin.js",
    "deploy": "npm run build && cd apps/web && wrangler pages deploy .next --project-name=clapculture",
    "deploy:pages": "npm run build && cd apps/web && wrangler pages deploy .next --project-name=clapculture",
    "deploy:api": "cd apps/api && wrangler deploy"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "wrangler": "^4.122.0"
  }
}
